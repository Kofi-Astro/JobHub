# ---------------------------------------------------------------------------
# JobHub .gitignore
# Keep the repo limited to source + config. Anything generated, secret, or
# environment-specific stays out.
# ---------------------------------------------------------------------------

# --- Secrets / environment ---
# Real credentials live in .env (local) or the Railway dashboard (prod).
# Only .env.example is committed.
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Tailwind build ---
# (.gitignore does not support inline "# comment" suffixes on a pattern line —
# each entry below is a bare pattern with any explanation on its own line.)
node_modules/
# Generated by the Tailwind CLI from css/input.css; run `npm run build`.
frontend/css/tailwind.css

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
# .vscode/ is intentionally NOT ignored so shared launch/debug config can be committed,
# but ignore the machine-local settings file.
.vscode/settings.json

# --- Docker / data volumes ---
pgdata/
*.dump
