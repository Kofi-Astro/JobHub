# ===========================================================================
# JobHub environment configuration
#
# Copy to `.env` for local development. In production (Railway) set these in the
# service "Variables" tab instead — never commit real secrets.
#
# The application reads these via `app/config.py` (pydantic-settings). Anything
# without a default here is REQUIRED.
# ===========================================================================

# --- Core ---------------------------------------------------------------------
# SQLAlchemy URL. Use the psycopg (v3) driver. Railway's Postgres plugin injects
# DATABASE_URL as `postgresql://…`; app/config.py rewrites the scheme to
# `postgresql+psycopg://…` automatically, so the plugin value works as-is.
DATABASE_URL=postgresql+psycopg://jobhub:jobhub@localhost:5432/jobhub

# Environment name: local | staging | production. Controls log format, docs
# exposure, and CORS strictness.
ENVIRONMENT=local

# Comma-separated list of origins allowed to call the API from a browser.
# Include wherever the static frontend is served from.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Auth --------------------------------------------------------------------
# HMAC secret for signing JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0000000000000000000000000000
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Ingestion / external APIs ---------------------------------------------
# Global default politeness delay + retry budget for outbound source calls.
HTTP_DEFAULT_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Keyed adapters. Leave blank to keep the source disabled. The `sources` table's
# `api_key_ref` column names which of these a given source uses.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# --- Email (saved-search alerts, employer notifications) -------------------
# Any SMTP provider. If SMTP_HOST is blank, the app logs emails instead of
# sending them (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=JobHub <no-reply@jobhub.example>

# --- Worker ----------------------------------------------------------------
# Days an aggregated job can go unseen by its source before being auto-expired.
STALE_JOB_EXPIRY_DAYS=14

# --- Frontend ------------------------------------------------------------------
# Baked into frontend/js/config.js at deploy time (see Makefile `frontend-build`).
API_BASE_URL=http://localhost:8000
